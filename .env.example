# ── REQUIRED for real AI conversation ──────────────────────────────
# Free key: https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: force a specific model (the app auto-tries several if this is empty)
# GEMINI_MODEL=gemini-2.5-flash

# ── OPTIONAL but recommended: FREE backup AI (Groq). Used if Gemini is slow, rate-limited or down.
# Free key: https://console.groq.com  ->  API Keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ── OPTIONAL: automatic WhatsApp alerts + phone call (Twilio free trial) ──
# Without these, VRAAYU still works: it opens WhatsApp with the message ready to send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Only for the automatic SOS phone call (a Twilio number, e.g. +1...)
TWILIO_PHONE_NUMBER=

# ── OPTIONAL: permanent database for the Family dashboard (Supabase) ──
# Without these, family data is kept in server memory (fine for a demo).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
